// Holodeck v3: the chamber. Lana and Mila stand static in the graded room photo; the
// overlay is the approved mockup (out/03_active_annotated.jpg) made live:
//   nets          one per real fleet node; brightness = state, twinkling = working
//   waveguides    floor runs along the cable routes, brighter when anyone is working
//   points        one point of light = one real message/handoff event (Renderer.js)
//   MCP prisms    lit while a node reports a tool call
//   seat lip      flashes when Lana or Mila starts a turn (Martin's input arriving)
//   memory drum   Hindsight halo. retain = a warm point runs Lana's ceiling line INTO the
//                 drum and lights the write arc; recall = the ring catches light and a
//                 cool point runs OUT to Lana, whose core fires on arrival
//   nets          drawn live (NetView.qml): still when offline, drifting when idle,
//                 spikes cascading along edges when working
//   glyphs        thinking glyphs above whichever sister is working
// Data: the same files and the same Renderer.js model as the live holo
// (~/.local/state/holo/fleet.json + beacon-vps.json), so freshness rules and
// fail-closed UNKNOWN/UNLINKED handling are identical. Nothing here writes state.
// Geometry and layers come from Scene.js, generated by build/build_assets.py.
// Motion is timer-driven (SequentialAnimation/Behavior are unreliable in this build).
import Quickshell
import Quickshell.Wayland
import Quickshell.Io
import QtQuick
import "Renderer.js" as Renderer
import "Scene.js" as Scene

ShellRoot {
  id: root

  readonly property string home: Quickshell.env("HOME")
  readonly property string stateDir: home + "/.local/state/holo/"
  readonly property var sc: Scene.scene
  function asset(name) { return Qt.resolvedUrl("assets/" + name) }

  property var fleet: null
  property var beacon: null
  property var view: []
  property var nodeMap: ({})
  property var spareFor: ({})        // spare layer -> view node
  property var particleView: []
  property var pulseState: null
  property var totals: ({})
  property real beaconAge: -1
  property bool vpsStale: true
  property real now: Date.now() / 1000
  property real t: 0
  property int tick: 0
  property real previewUntil: 0      // IPC preview only; never set by data
  property real lipAt: -100
  readonly property string memKey: '["vps","hindsight"]'
  readonly property string lanaKey: '["vps","default"]'
  property var memFx: ({})          // eventId -> {kind, start, landed}
  property real retainAt: -100
  property real recallAt: -100
  property var wasWorking: ({})
  property var smokeP1: null         // ~/.local/state/holo/smoke-p1.json (holo-smoke, P1 half)
  property var smokeVps: null        // smoke-vps.json (written here by the VPS half over ssh)
  property real smokeClickAt: -100
  property var cur: ({})             // smoothed levels, keyed by name
  property var routes: ({})

  readonly property color warm: "#ffb35c"
  readonly property color cool: "#80d6ff"
  readonly property color rose: "#ffa89e"
  readonly property var toolWords: ["BUILDING", "READING", "SEARCHING", "TOOLING", "WAITING_TOOL"]
  // Status line = the Hermes CLI's own vocabulary (agent/display.py KawaiiSpinner + tool registry emojis).
  // Nothing animates on a clock: a new face/verb is picked only when the reported state changes,
  // the same moment the CLI picks one (new model call -> thinking face + verb; tool -> waiting face).
  readonly property var hermesThinkingFaces: ["(｡•́︿•̀｡)", "(◔_◔)", "(¬‿¬)", "( •_•)>⌐■-■", "(⌐■_■)", "(´･_･`)", "◉_◉", "(°ロ°)",
    "( ˘⌣˘)♡", "ヽ(>∀<☆)☆", "٩(๑❛ᴗ❛๑)۶", "(⊙_⊙)", "(¬_¬)", "( ͡° ͜ʖ ͡°)", "ಠ_ಠ"]
  readonly property var hermesWaitingFaces: ["(｡◕‿◕｡)", "(◕‿◕✿)", "٩(◕‿◕｡)۶", "(✿◠‿◠)", "( ˘▽˘)っ", "♪(´ε` )", "(◕ᴗ◕✿)", "ヾ(＾∇＾)", "(≧◡≦)", "(★ω★)"]
  readonly property var hermesThinkingVerbs: ["pondering", "contemplating", "musing", "cogitating", "ruminating", "deliberating", "mulling",
    "reflecting", "processing", "reasoning", "analyzing", "computing", "synthesizing", "formulating", "brainstorming"]
  // state word -> [tool emoji from the Hermes registry, verb]; the VPS bridge folds tools into these codes
  readonly property var hermesTool: ({BUILDING: ["✍️", "building"], READING: ["📖", "reading"], SEARCHING: ["🔎", "searching"],
    RUNNING: ["💻", "running"], TOOLING: ["💻", "running"], WAITING_TOOL: ["💻", "waiting"], DELEGATING: ["🔀", "delegating"],
    LISTENING: ["", "listening"], REPORTING: ["", "reporting"], RESPONDING: ["", "answering"]})
  property var glyphItems: []
  function glyphLines() { return glyphItems.map(function(g) { return g.line }) }
  function pick(a) { return a[Math.floor(Math.random() * a.length)] }
  function statusLine(st) {
    if (st === "THINKING" || st === "ACTIVE" || st === "WORKING" || st === "") return pick(hermesThinkingFaces) + " " + pick(hermesThinkingVerbs) + "…"
    var t = hermesTool[st] || ["", String(st).toLowerCase()]
    return pick(hermesWaitingFaces) + " " + (t[0] ? t[0] + " " : "") + t[1] + "…"
  }

  // ------------------------------------------------------------ data in
  function ingest(text, fromBeacon, exitOk) {
    var snap = Renderer.ingest(text, fromBeacon ? root.beacon : root.fleet, fromBeacon, Date.now() / 1000, exitOk)
    if (fromBeacon) root.beacon = snap; else root.fleet = snap
    root.rebuild()
  }
  function rebuild() {
    var n = Date.now() / 1000
    var r = Renderer.build(root.fleet, root.beacon, n, 1920)
    var map = {}
    r.view.forEach(function(v) { map[v.key] = v })
    root.nodeMap = map
    root.view = r.view
    // profiles that have no designed net get a spare slot on their own side
    var known = {}
    root.sc.nets.forEach(function(e) { if (e.id.indexOf("__spare") !== 0) known[Renderer.key(e.machine, e.id)] = true })
    var spares = {vps: [], p1: []}
    root.sc.nets.forEach(function(e) { if (e.id.indexOf("__spare") === 0) spares[e.machine].push(e.layer) })
    var sp = {}
    r.view.forEach(function(v) {
      if (known[v.key] || v.role === "LEAF" || v.id === "hindsight") return
      var list = spares[v.machine === "vps" ? "vps" : "p1"]
      if (list.length) sp[list.shift()] = v
    })
    if (JSON.stringify(Object.keys(sp).map(function(k) { return k + sp[k].key })) !==
        JSON.stringify(Object.keys(root.spareFor).map(function(k) { return k + root.spareFor[k].key }))) root.routes = {}
    root.spareFor = sp
    // a sister starting a turn = input arriving at the seat
    var ww = {}
    ;["[\"vps\",\"default\"]", "[\"p1\",\"p1-mila\"]"].forEach(function(k) {
      var v = map[k], w = !!(v && v.working)
      if (w && root.wasWorking[k] === false) root.lipAt = n
      ww[k] = v ? w : undefined
    })
    root.wasWorking = ww
    root.pulseState = Renderer.advancePulses(root.pulseState, r.particles, n, r.view.map(function(v) { return v.key }))
    root.particleView = root.pulseState.particles
    root.totals = r.totals
    root.beaconAge = r.beaconAge
    root.vpsStale = r.vpsStale
  }

  Process {
    id: fleetProc
    command: ["cat", root.stateDir + "fleet.json"]
    stdout: StdioCollector { id: fleetOut }
    onExited: (code, status) => root.ingest(fleetOut.text, false, code === 0)
  }
  Process {
    id: beaconProc
    command: ["cat", root.stateDir + "beacon-vps.json"]
    stdout: StdioCollector { id: beaconOut }
    onExited: (code, status) => root.ingest(beaconOut.text, true, code === 0)
  }
  // full fleet smoke (double-click the throne): results only, nothing here writes state
  function readJson(t) { try { return JSON.parse(t) } catch (e) { return null } }
  Process {
    id: smokeP1Proc
    command: ["cat", root.stateDir + "smoke-p1.json"]
    stdout: StdioCollector { id: smokeP1Out }
    onExited: (code, status) => root.smokeP1 = code === 0 ? root.readJson(smokeP1Out.text) : null
  }
  Process {
    id: smokeVpsProc
    command: ["cat", root.stateDir + "smoke-vps.json"]
    stdout: StdioCollector { id: smokeVpsOut }
    onExited: (code, status) => root.smokeVps = code === 0 ? root.readJson(smokeVpsOut.text) : null
  }
  Process { id: smokeRun; command: [root.home + "/.local/bin/holo-smoke"] }
  function startSmoke() {
    var n = Date.now() / 1000
    if (n - root.smokeClickAt < 5) return "ignored (double fire)"
    root.smokeClickAt = n; root.lipAt = n
    smokeRun.startDetached()           // the script owns the 10-minute cooldown
    return "started"
  }
  function smokeLine() {
    var p = root.smokeP1
    if (!p || !p.run) return ""
    var n = root.now
    if (p.state === "done" && n - (p.finished || p.started) > 600) return ""
    var v = root.smokeVps && root.smokeVps.run === p.run ? root.smokeVps : null
    var items = [], ok = 0, total = 0, fail = []
    ;["mila", "a2a", "staff1", "staff2", "staff3", "staff4"].forEach(function(k) { items.push([k, p.bots ? p.bots[k] : null]) })
    ;["researcher", "analyst", "architect", "auditor", "librarian", "news", "playroom", "ride-test"].forEach(function(k) {
      items.push([k, v && v.bots ? v.bots[k] : null]) })
    items.push(["hindsight", v ? v.hindsight : null])
    var pending = 0
    items.forEach(function(it) { total++; if (!it[1]) pending++; else if (it[1].ok) ok++; else fail.push(it[0]) })
    var a2a = p.bots ? p.bots.a2a : null
    var unreached = p.state === "done" && !v && a2a && !a2a.ok      // VPS half never started
    var running = !unreached && (p.state !== "done" || !v || v.state !== "done")
    return "SMOKE " + p.run + "  ·  " + ok + "/" + total + (running ? "  ·  RUNNING" + (pending ? " (" + pending + " waiting)" : "") : "")
         + (fail.length ? "  ·  ✗ " + fail.join(" ").toUpperCase() : (running ? "" : "  ·  ALL CLEAR"))
         + (unreached ? "  ·  VPS NOT REACHED" : "")
  }
  Timer {
    interval: 2000; running: true; repeat: true; triggeredOnStart: true
    onTriggered: {
      if (!fleetProc.running) fleetProc.running = true
      if (!beaconProc.running) beaconProc.running = true
      if (!smokeP1Proc.running) smokeP1Proc.running = true
      if (!smokeVpsProc.running) smokeVpsProc.running = true
    }
  }
  Timer { interval: 1000; running: true; repeat: true; onTriggered: root.rebuild() }

  // ------------------------------------------------------------ state -> levels
  function netNode(e) {
    if (e.id.indexOf("__spare") === 0) return root.spareFor[e.layer] || null
    return root.nodeMap[Renderer.key(e.machine, e.id)] || null
  }
  function preview() { return root.now < root.previewUntil }
  function targetLevel(e) {
    var v = root.netNode(e)
    if (!v) return e.id.indexOf("__spare") === 0 ? 0 : 0.1
    if (root.preview() || v.working) return 0.8 + 0.2 * (root.preview() ? 1 : (v.activity || 0))
    if (v.state === "IDLE") return 0.5
    if (v.state === "OFFLINE") return 0.22
    return 0.13                        // UNKNOWN / UNLINKED: barely there
  }
  function isTool(v) { return !!v && (v.toolActive === true || root.toolWords.indexOf(v.state) >= 0) }
  function prismTarget(p) {
    if (root.preview()) return (p.side === "L" && p.slot === 1) || (p.side === "R" && p.slot === 0) ? 1 : 0
    var lana = root.nodeMap["[\"vps\",\"default\"]"], mila = root.nodeMap["[\"p1\",\"p1-mila\"]"]
    if (p.side === "L" && p.slot === 1) return root.isTool(lana) ? 1 : 0
    if (p.side === "R" && p.slot === 0) return root.isTool(mila) ? 1 : 0
    var machine = p.side === "L" ? "vps" : "p1", n = 0
    for (var i = 0; i < root.view.length; i++) {
      var v = root.view[i]
      if (v.machine !== machine || v.id === "default" || v.id === "p1-mila" || !root.isTool(v)) continue
      n++
      if ((p.side === "L" ? (p.slot === 0 ? 1 : 2) : p.slot) === n) return 1
    }
    return 0
  }
  function smoothTo(name, target, rate) {
    var c = root.cur[name]
    root.cur[name] = c === undefined ? target : c + (target - c) * rate
  }
  function lvl(name, tickDep) { var c = root.cur[name]; return c === undefined ? 0 : c }

  Timer {
    interval: 40; running: true; repeat: true
    onTriggered: {
      root.now = Date.now() / 1000
      root.t += 0.04
      var any = root.preview()
      root.sc.nets.forEach(function(e) {
        var v = root.netNode(e)
        root.smoothTo(e.layer, root.targetLevel(e), 0.05)
        root.smoothTo("w:" + e.layer, root.preview() || (v && v.working) ? 1 : 0, 0.05)
        if (v && v.working) any = true
      })
      root.smoothTo("q", any ? 1 : 0, 0.03)
      root.sc.prisms.forEach(function(p) { root.smoothTo(p.name, root.prismTarget(p), 0.15) })
      root.smoothTo("mem", root.memAlive() ? 1 : 0.35, 0.05)
      root.memStep()
      for (var i = 0; i < netViews.count; i++) { var nv = netViews.itemAt(i); if (nv) nv.view.step() }
      root.tick++
    }
  }

  // ------------------------------------------------------------ Hindsight
  function memAlive() { var m = root.nodeMap[root.memKey]; return !!m && m.state !== "OFFLINE" && m.state !== "UNKNOWN" && m.state !== "UNLINKED" }
  function memKind(evt) { var id = String(evt.eventId); return id.indexOf("mem.retain") === 0 ? "retain" : id.indexOf("mem.recall") === 0 ? "recall" : "" }
  function lanaView() {
    for (var i = 0; i < netViews.count; i++) { var it = netViews.itemAt(i); if (it && it.net.id === "default") return it.view }
    return null
  }
  // departure and landing effects for memory pulses (6 s journeys, Renderer.pulseProgress)
  function memStep() {
    var fx = root.memFx, keep = {}
    root.particleView.forEach(function(p) {
      var k = root.memKind(p); if (!k) return
      var start = typeof p.displayAt === "number" ? p.displayAt : p.eventAt
      var f = fx[p.eventId] || {kind: k, start: start, left: false, landed: false}
      if (!f.left && root.now >= start) {
        f.left = true
        if (k === "retain") { var lv = root.lanaView(); if (lv) lv.burst(2) }
        else root.recallAt = root.now
      }
      if (!f.landed && root.now >= start + 6) {
        f.landed = true
        if (k === "retain") root.retainAt = root.now
        else { var lv2 = root.lanaView(); if (lv2) lv2.burst(5) }
      }
      keep[p.eventId] = f
    })
    for (var id in fx) if (!keep[id] && !fx[id].landed && root.now - fx[id].start < 7) keep[id] = fx[id]
    root.memFx = keep
  }
  function memRoute(toDrum) {
    var lana = null
    for (var i = 0; i < root.sc.nets.length; i++) if (root.sc.nets[i].id === "default") lana = root.sc.nets[i]
    if (!lana || !lana.ceiling) return null
    var pts = lana.ceiling.slice()
    pts.push(root.sc.drumTop)
    if (!toDrum) pts.reverse()
    var cum = [0]
    for (var j = 1; j < pts.length; j++) cum.push(cum[j - 1] + Math.hypot(pts[j][0] - pts[j - 1][0], pts[j][1] - pts[j - 1][1]))
    return {pts: pts, cum: cum}
  }

  // ------------------------------------------------------------ pulse routes
  function netFor(key) {
    for (var i = 0; i < root.sc.nets.length; i++) {
      var e = root.sc.nets[i]
      if (e.id.indexOf("__spare") === 0) { var s = root.spareFor[e.layer]; if (s && s.key === key) return e }
      else if (Renderer.key(e.machine, e.id) === key) return e
    }
    return null
  }
  function runSlice(side, from, to) {
    var r = root.sc.runs[side], out = []
    if (from <= to) for (var i = from; i <= to; i++) out.push(r[i])
    else for (var j = from; j >= to; j--) out.push(r[j])
    return out
  }
  // net -> its tendril -> floor run -> (through the chair if crossing sides) -> run -> tendril -> net
  function route(fromKey, toKey) {
    var id = fromKey + ">" + toKey
    if (root.routes[id] !== undefined) return root.routes[id]
    var a = root.netFor(fromKey), b = root.netFor(toKey), pts = null
    if (toKey === root.memKey || fromKey === root.memKey) pts = root.memRoute(toKey === root.memKey)
    else if (a && b && a.drop && b.drop) {
      pts = a.drop.slice()
      if (a.side === b.side) pts = pts.concat(root.runSlice(a.side, a.runIdx, b.runIdx))
      else pts = pts.concat(root.runSlice(a.side, a.runIdx, 0), root.runSlice(b.side, 0, b.runIdx))
      pts = pts.concat(b.drop.slice().reverse())
      var cum = [0]
      for (var i = 1; i < pts.length; i++)
        cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]))
      pts = {pts: pts, cum: cum}
    }
    root.routes[id] = pts            // in-place: no change signal from inside a binding
    return pts
  }
  function along(r, p) {
    if (!r) return [-100, -100]
    var L = r.cum[r.cum.length - 1] * p, i = 1
    while (i < r.cum.length - 1 && r.cum[i] < L) i++
    var seg = r.cum[i] - r.cum[i - 1], u = seg > 0 ? (L - r.cum[i - 1]) / seg : 0
    return [r.pts[i - 1][0] + (r.pts[i][0] - r.pts[i - 1][0]) * u, r.pts[i - 1][1] + (r.pts[i][1] - r.pts[i - 1][1]) * u]
  }
  function masked(x, y) {   // behind legs / chair base
    for (var i = 0; i < root.sc.masks.length; i++) {
      var m = root.sc.masks[i]
      if (x > m[0] && x < m[2] && y > m[1] && y < m[3]) return true
    }
    return false
  }
  function inject(pairs) {
    var n = root.now, evs = []
    pairs.forEach(function(p, i) {
      evs.push({eventId: "probe:" + n + ":" + i, eventAt: n, active: true, fromId: p[0], toId: p[1], kind: "smoke_test"})
    })
    root.pulseState = Renderer.advancePulses(root.pulseState, evs, n, root.view.map(function(v) { return v.key }))
    root.particleView = root.pulseState.particles
    return evs.length
  }

  // ------------------------------------------------------------ control (read-only; debug + snapshots)
  IpcHandler {
    target: "holov3"
    function snapshot(path: string): string {
      stage.grabToImage(function(res) { res.saveToFile(path) })
      return "saving " + path
    }
    function preview(seconds: real): string { root.previewUntil = root.now + seconds; return "preview " + seconds + "s (display only)" }
    function probe(): string {
      return "fired " + root.inject([["[\"vps\",\"default\"]", "[\"p1\",\"p1-mila\"]"], ["[\"p1\",\"staff1\"]", "[\"p1\",\"p1-mila\"]"],
                                     ["[\"vps\",\"researcher\"]", "[\"vps\",\"default\"]"]])
    }
    function memprobe(): string {
      var n = root.now
      var evs = [{eventId: "mem.retain.probe." + n, eventAt: n, active: true, fromId: root.lanaKey, toId: root.memKey, kind: "memory"},
                 {eventId: "mem.recall.probe." + n, eventAt: n + 3, active: true, fromId: root.memKey, toId: root.lanaKey, kind: "memory"}]
      root.pulseState = Renderer.advancePulses(root.pulseState, evs, n, root.view.map(function(v) { return v.key }))
      root.particleView = root.pulseState.particles
      return "fired retain + recall (display only)"
    }
    function status(): string {
      return JSON.stringify({nodes: root.view.length, particles: root.particleView.length, beaconAge: root.beaconAge,
        vpsStale: root.vpsStale, q: root.lvl("q"), spares: Object.keys(root.spareFor).length, preview: root.preview(),
        figures: {lana: figLana.phase, mila: figMila.phase}, glyphs: root.glyphLines(),
        states: root.view.map(function(v) { return v.machine + ":" + v.id + "=" + v.state })})
    }
    function figdemo(name: string, cycles: int): string { return (name === "mila" ? figMila : figLana).demo(cycles) }
    function smoke(): string { return root.startSmoke() }
    function smokeStatus(): string { return root.smokeLine() }
  }

  // ------------------------------------------------------------ surface
  PanelWindow {
    id: win
    anchors { top: true; bottom: true; left: true; right: true }
    color: "black"
    exclusionMode: ExclusionMode.Ignore
    mask: Region { item: throneHot }     // input only on the throne; everything else passes through
    WlrLayershell.layer: WlrLayer.Background
    WlrLayershell.namespace: "holo-v3"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    Item {
      id: stage
      width: 1920; height: 1080
      transformOrigin: Item.TopLeft
      scale: Math.max(win.width / 1920, win.height / 1080)

      Image { anchors.fill: parent; source: root.asset("base.jpg"); smooth: true }

      // double-click the middle of the throne = full fleet smoke test
      Item {
        id: throneHot
        x: 830; y: 420; width: 260; height: 620
        MouseArea { anchors.fill: parent; onDoubleClicked: root.startSmoke() }
      }

      // Lana and Mila: dormant until working, then come to attention (Figure.qml)
      Figure {
        id: figLana; name: "lana"; b: [156, 0, 618, 1080]; now: root.now; ready: root.fleet !== null && root.beacon !== null
        working: root.preview() || !!(root.nodeMap[root.lanaKey] && root.nodeMap[root.lanaKey].working)
      }
      Figure {
        id: figMila; name: "mila"; b: [1134, 0, 618, 1080]; now: root.now; ready: root.fleet !== null && root.beacon !== null
        working: root.preview() || !!(root.nodeMap['["p1","p1-mila"]'] && root.nodeMap['["p1","p1-mila"]'].working)
      }

      // floor waveguides (masked behind legs and chair in the asset)
      Repeater {
        model: ["floor_L", "floor_R"]
        Image {
          property var b: root.sc.layers[modelData]
          x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset(modelData + ".png")
          opacity: (0.5 + 0.5 * root.lvl("q", root.tick)) * (0.92 + 0.08 * Math.sin(root.t * 0.7 + index * 2))
        }
      }
      Repeater {
        model: root.sc.prisms
        Image {
          property var b: root.sc.layers[modelData.name]
          x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset(modelData.name + ".png")
          opacity: root.lvl(modelData.name, root.tick) * (0.85 + 0.15 * Math.sin(root.t * 9))
          visible: opacity > 0.01
        }
      }

      // Hindsight memory drum on the halo
      Image {
        property var b: root.sc.layers["drum"]
        x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset("drum.png")
        opacity: root.lvl("mem", root.tick) * (0.5 + 0.5 * root.lvl("q", root.tick)) * (0.88 + 0.12 * Math.sin(root.t * 0.45))
      }
      Image {
        property var b: root.sc.layers["drum_read"]
        x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset("drum_read.png")
        opacity: 0.9 * Math.max(0, 1 - Math.abs(root.now - root.recallAt - 0.4) / 1.6)
        visible: opacity > 0.01
      }
      Image {
        property var b: root.sc.layers["drum_write"]
        x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset("drum_write.png")
        opacity: root.now < root.retainAt ? 0 : Math.max(0, 1 - (root.now - root.retainAt) / 4)
        visible: opacity > 0.01
      }
      Text {
        text: "HINDSIGHT"
        x: root.sc.drumTop[0] - width / 2; y: root.sc.drumTop[1] - 34
        color: "#efe4cc"; opacity: 0.22 + 0.5 * Math.max(0, 1 - Math.min(Math.abs(root.now - root.retainAt), Math.abs(root.now - root.recallAt)) / 3)
        font.family: "Noto Sans Mono"; font.pixelSize: 9; font.letterSpacing: 3
      }
      // empty seat lip: input arriving
      Image {
        property var b: root.sc.layers["seat_lip"]
        x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset("seat_lip.png")
        opacity: 0.2 + 0.8 * Math.max(0, 1 - (root.now - root.lipAt) / 3)
      }

      // the networks: static stems + haze, live net on top
      Repeater {
        model: root.sc.nets
        Image {
          property var b: root.sc.layers[modelData.layer + "_stem"]
          visible: modelData.stem && b !== undefined && opacity > 0.01
          x: b ? b.x : 0; y: b ? b.y : 0; width: b ? b.w : 0; height: b ? b.h : 0
          source: b ? root.asset(modelData.layer + "_stem.png") : ""
          opacity: root.lvl(modelData.layer, root.tick)
        }
      }
      Repeater {
        id: netViews
        model: root.sc.nets
        Item {
          readonly property var net: modelData
          property alias view: nv
          readonly property var node: root.netNode(modelData)
          readonly property real lv: root.lvl(modelData.layer, root.tick)
          visible: lv > 0.01
          Image {
            property var b: root.sc.layers[modelData.layer + "_haze"]
            x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset(modelData.layer + "_haze.png")
            opacity: lv * (0.75 + 0.25 * root.lvl("w:" + modelData.layer, root.tick))
          }
          NetView {
            id: nv
            e: modelData
            box: root.sc.layers[modelData.layer + "_core"]
            tint: modelData.color
            t: root.t
            opacity: lv
            mode: root.preview() || (node && node.working) ? "work" : node && node.state === "IDLE" ? "idle" : "off"
            activity: root.preview() ? 1 : node && node.activity ? node.activity : 0
          }
        }
      }

      // staff labels, faint
      Repeater {
        model: root.sc.nets
        Text {
          readonly property var node: root.netNode(modelData)
          visible: modelData.id !== "default" && modelData.id !== "p1-mila" && (modelData.label !== "" || node !== null) && root.lvl(modelData.layer, root.tick) > 0.01
          text: (modelData.label !== "" ? modelData.label : (node ? String(node.label).toUpperCase() : "")) + (node && node.working ? " · " + String(node.word).toLowerCase() : "")
          x: modelData.cx - width / 2; y: modelData.cy + modelData.sc * 1.05 + 4
          color: modelData.color === "cool" ? root.cool : modelData.color === "rose" ? root.rose : root.warm
          opacity: 0.18 + 0.4 * root.lvl(modelData.layer, root.tick)
          font.family: "Noto Sans Mono"; font.pixelSize: 9; font.letterSpacing: 1.5
        }
      }

      // thinking glyphs, placement A (above each sister)
      Repeater {
        model: [{side: "L", key: "[\"vps\",\"default\"]", net: "net_vps_default", col: "warm"},
                {side: "R", key: "[\"p1\",\"p1-mila\"]", net: "net_p1_p1-mila", col: "cool"}]
        Item {
          id: gl
          readonly property var node: root.nodeMap[modelData.key]
          readonly property real w: root.lvl("w:" + modelData.net, root.tick)
          readonly property color c: modelData.col === "cool" ? root.cool : root.warm
          // what she is really doing; "" while not working (preview counts as a think)
          readonly property string st: gl.node && gl.node.working ? String(gl.node.state) : (root.preview() ? "THINKING" : "")
          property string line: ""
          property string oldLine: ""
          onStChanged: if (st !== "") { oldLine = line; line = root.statusLine(st); swap.restart() }
          Component.onCompleted: { root.glyphItems = root.glyphItems.concat([gl]); if (st !== "") line = root.statusLine(st) }
          NumberAnimation { id: swap; target: newer; property: "opacity"; from: 0; to: 1; duration: 350; easing.type: Easing.OutQuad }
          visible: w > 0.02
          opacity: w
          Image {
            property var b: root.sc.layers["glyph_thread_" + modelData.side]
            x: b.x; y: b.y; width: b.w; height: b.h; source: root.asset("glyph_thread_" + modelData.side + ".png")
          }
          Item {   // one status line; old text fades out under the new one only when the state changes
            x: root.sc.glyphs[modelData.side][0]; y: root.sc.glyphs[modelData.side][1] - 8
            Text { anchors.horizontalCenter: parent.horizontalCenter; color: gl.c; text: gl.oldLine; opacity: 1 - newer.opacity
                   font.family: "Noto Sans Mono"; font.pixelSize: 17; style: Text.Outline; styleColor: Qt.rgba(gl.c.r, gl.c.g, gl.c.b, 0.25) }
            Text { id: newer; anchors.horizontalCenter: parent.horizontalCenter; color: gl.c; text: gl.line
                   font.family: "Noto Sans Mono"; font.pixelSize: 17; style: Text.Outline; styleColor: Qt.rgba(gl.c.r, gl.c.g, gl.c.b, 0.25) }
          }
        }
      }

      // one point of light = one real message
      Repeater {
        model: root.particleView
        Image {
          readonly property var evt: modelData
          readonly property var prog: Renderer.pulseProgress(evt, root.now)
          readonly property var r: root.route(evt.fromId, evt.toId)
          readonly property var pt: root.along(r, prog === null ? 0 : prog)
          readonly property string mk: root.memKind(evt)
          source: root.asset(mk === "retain" ? "spark_retain.png" : mk === "recall" ? "spark_recall.png" : "spark.png")
          width: 30; height: 30
          x: pt[0] - 15; y: pt[1] - 15
          visible: prog !== null && r !== null && !root.masked(pt[0], pt[1])
          opacity: prog === null ? 0 : Math.min(1, prog * 12, (1 - prog) * 12)
        }
      }

      // status line, quiet, under the chair
      Text {
        anchors.horizontalCenter: parent.horizontalCenter; y: 1050
        text: "NODES " + (root.totals.nodes_online === null || root.totals.nodes_online === undefined ? "?" : root.totals.nodes_online - (root.memAlive() ? 1 : 0))
              + "/" + Math.max(0, (root.totals.nodes_total || 0) - (root.nodeMap[root.memKey] ? 1 : 0)) + "  ·  WORKING " + (root.totals.working || 0)
              + "  ·  BEACON " + (root.beaconAge < 0 ? "NONE" : root.beaconAge < 90 ? Math.round(root.beaconAge) + "S" : Math.round(root.beaconAge / 60) + "M")
              + "  ·  MEMORY " + (root.nodeMap[root.memKey] ? (root.memAlive() ? "OK" : "DOWN") : "?")
              + (root.preview() ? "  ·  PREVIEW" : "")
        color: root.vpsStale ? "#d46a2b" : "#c9b48f"
        opacity: 0.45
        font.family: "Noto Sans Mono"; font.pixelSize: 10; font.letterSpacing: 2
      }
      Text {   // fleet smoke result (throne double-click)
        anchors.horizontalCenter: parent.horizontalCenter; y: 1030
        property string line: root.smokeLine(root.tick)
        text: line; visible: line !== ""
        color: line.indexOf("✗") >= 0 ? "#e8895a" : line.indexOf("ALL CLEAR") >= 0 ? "#9fe0b0" : "#efe4cc"
        opacity: line.indexOf("RUNNING") >= 0 ? 0.55 + 0.3 * Math.sin(root.t * 3) : 0.75
        font.family: "Noto Sans Mono"; font.pixelSize: 11; font.letterSpacing: 2
      }
    }
  }
}
